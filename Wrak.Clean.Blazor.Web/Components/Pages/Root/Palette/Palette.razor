@inherits PaletteBase
@page "/palette"

<PageTitle>Palette</PageTitle>

<PageHeader>Palette</PageHeader>

<MudStack Class="flex-wrap d-flex flex-sm-row flex-column mb-8"
          AlignItems="AlignItems.Stretch"
          Justify="Justify.SpaceEvenly"
          Spacing="4">

    <Alert Visible="true" Severity="Severity.Normal">
        This is a Normal alert.
    </Alert>

    <Alert Visible="true" Severity="Severity.Success">
        This is a Success alert.
    </Alert>

    <Alert Visible="true" Severity="Severity.Warning">
        This is a Warning alert.
    </Alert>

    <Alert Visible="true" Severity="Severity.Error">
        This is an Error alert.
    </Alert>

    <Alert Visible="true" Severity="Severity.Info">
        This is an Info alert.
    </Alert>
</MudStack>

<MudStack Class="flex-wrap d-flex flex-sm-row flex-column mb-8"
          AlignItems="AlignItems.Stretch"
          Justify="Justify.SpaceEvenly"
          Spacing="4">

    <MudButton Color="Color.Default" Variant="Variant.Filled">
        Default Button
    </MudButton>

    <MudButton Color="Color.Primary" Variant="Variant.Filled">
        Primary Button
    </MudButton>

    <MudButton Color="Color.Secondary" Variant="Variant.Filled">
        Secondary Button
    </MudButton>

    <MudButton Color="Color.Success" Variant="Variant.Filled">
        Success Button
    </MudButton>

    <MudButton Color="Color.Warning" Variant="Variant.Filled">
        Warning Button
    </MudButton>

    <MudButton Color="Color.Error" Variant="Variant.Filled">
        Error Button
    </MudButton>

    <MudButton Color="Color.Info" Variant="Variant.Filled">
        Info Button
    </MudButton>
</MudStack>