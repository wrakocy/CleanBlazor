{
  "permissions": {
    "allow": [
      "Bash(pwsh ./Verify-Package-Versions.ps1)",
      "Read",
      "Glob",
      "Grep",
      "Bash(ls:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git rev-parse:*)",
      "Bash(git merge-base:*)",
      "Bash(git symbolic-ref:*)",
      "Bash(git branch --show-current)",
      "Bash(git branch --list:*)",
      "Bash(git remote -v)",
      "Bash(git remote get-url:*)",
      "Bash(git fetch:*)",
      "Bash(git stash list:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh run list:*)",
      "Bash(gh run view:*)",
      "Bash(dotnet restore:*)",
      "Bash(dotnet build:*)",
      "Bash(dotnet test:*)",
      "Bash(dotnet format:*)",
      "Bash(dotnet list:*)",
      "Bash(dotnet --version)",
      "Bash(dotnet --info)"
    ]
  },
  "enabledPlugins": {
    "agentkit-core@wrak-agentkit": true,
    "agentkit-dotnet@wrak-agentkit": true
  },
  "extraKnownMarketplaces": {
    "wrak-agentkit": {
      "source": {
        "source": "github",
        "repo": "wrakocy/AgentKit",
        "ref": "v1.1.0"
      }
    }
  }
}
