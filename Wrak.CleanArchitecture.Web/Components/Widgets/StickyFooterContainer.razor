<MudContainer MaxWidth="MaxWidth.ExtraExtraLarge" Gutters="false">
    
    <!--Content area -->
    <MudContainer MaxWidth="MaxWidth.ExtraExtraLarge" 
                  Gutters="false" 
                  Class="sfpark-sticky-content"
                  Style="@ContentStyle">
        @Content
    </MudContainer>

    <!-- Sticky footer -->
    <MudContainer MaxWidth="MaxWidth.ExtraExtraLarge"
                  Gutters="false"
                  Class="sfpark-sticky-footer"
                  Style="@FooterStyle">
        @Footer
    </MudContainer>

</MudContainer>


