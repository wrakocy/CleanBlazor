{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Extensions.Localization": "Error"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "C:\\Logs\\Development\\Wrak.CleanBlazor.Web\\log.txt",
          "rollingInterval": "Day"
        }
      }
    ]
  },
  "DetailedErrors": true
} 