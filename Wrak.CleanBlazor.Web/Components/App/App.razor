@inherits AppBase

@using Microsoft.AspNetCore.Components.Web

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />

    <link href="@Assets["css/app.css"]" rel="stylesheet" />
    <link href="@Assets["css/calendar.css"]" rel="stylesheet" />
    <link href="@Assets["css/reconnect.css"]" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css?family=Roboto:300,400,500,700&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet" />
    <link href="_content/MudBlazor/MudBlazor.min.css" rel="stylesheet" />
    <link href="_content/Heron.MudCalendar/Heron.MudCalendar.min.css" rel="stylesheet" />

    <ImportMap />
    <HeadOutlet @rendermode="RenderMode.InteractiveServer" />
</head>

<body>
    <Routes @rendermode="RenderMode.InteractiveServer" />
    <ErrorNotificationBar />
    <ReconnectModal />

    <script src="@Assets["js/app.js"]"></script>
    <script src="@Assets["js/mask.js"]"></script>
    <script src="@Assets["js/reconnect.js"]" defer></script>
    <script src="@Assets["_framework/blazor.web.js"]"></script>
    <script src="https://unpkg.com/imask@7.6.1/dist/imask.js"></script>
    <script src="_content/MudBlazor/MudBlazor.min.js" type="module"></script>
    <script src="_content/Heron.MudCalendar/Heron.MudCalendar.min.js" type="module"></script>
</body>

</html>
