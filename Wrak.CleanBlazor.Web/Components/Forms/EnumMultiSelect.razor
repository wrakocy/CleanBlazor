@typeparam TEnum where TEnum : struct, Enum

<MudSelect T="TEnum"
           MultiSelection="true"
           SelectAll="true"
           SelectAllText="@SelectAllText"
           Clearable="@Clearable"
           Label="@Label"
           Placeholder="@("".ToStringOrEmpty())"
           Text="@SelectedValues.Select(x => x.ToDisplayName(UseShortNames)).ToCommaDelimitedString()"
           MultiSelectionTextFunc="@((_) => SelectedValues.Select(x => x.ToDisplayName(UseShortNames)).ToCommaDelimitedString())"
           Immediate="@false"
           ShrinkLabel="@true"
           Disabled="@Disabled"
           SelectedValues="@SelectedValues"
           SelectedValuesChanged="@OnSelectedValuesChanged"
           For="@For">
    @foreach (var enumValue in Enum.GetValues<TEnum>())
    {
        <MudSelectItem Class="@(ItemClassFunc?.Invoke(enumValue) ?? string.Empty)"
                       Style="@(ItemStyleFunc?.Invoke(enumValue) ?? string.Empty)"
                       Value="@enumValue">
            @if (ItemTemplate != null)
            {
                @ItemTemplate(enumValue)
            }
            else
            {
                @enumValue.ToDisplayName(UseShortNames)
            }
        </MudSelectItem>
    }
</MudSelect>