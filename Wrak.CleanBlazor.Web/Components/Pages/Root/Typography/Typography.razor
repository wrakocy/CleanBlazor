@inherits TypographyBase
@page "/typography"

<PageTitle>Typography</PageTitle>

<PageHeader>Typography</PageHeader>

<MudPaper Style="padding: 24px !important;">
    <MudStack Class="mb-8"
              AlignItems="AlignItems.Stretch"
              Justify="Justify.SpaceEvenly"
              Spacing="4">

        <MudText Typo="Typo.h1">Header 1</MudText>
        <MudText Typo="Typo.h2">Header 2</MudText>
        <MudText Typo="Typo.h3">Header 3</MudText>
        <MudText Typo="Typo.h4">Header 4</MudText>
        <MudText Typo="Typo.h5">Header 5</MudText>
        <MudText Typo="Typo.h6">Header 6</MudText>

        <MudText Typo="Typo.body1">Body 1</MudText>
        <MudText Typo="Typo.body1">Body 2</MudText>

        <MudText Typo="Typo.subtitle1">Subtitle 1</MudText>
        <MudText Typo="Typo.subtitle1">Subtitle 2</MudText>

        <MudText Typo="Typo.caption">Caption</MudText>

        <MudText Typo="Typo.button">Button</MudText>
    </MudStack>
</MudPaper>