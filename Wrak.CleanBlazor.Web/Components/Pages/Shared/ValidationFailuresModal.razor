@using Wrak.CleanBlazor.Web.Components.Layouts

<Dialog>
    <MudText Typo="Typo.h2"
             Color="Color.Warning"
             Style="font-weight:900; display:flex; align-items:center;"
             Class="mb-4">
        <MudIcon Size="Size.Medium"
                 Class="me-2"
                 Icon="@AppConstants.Icons.Warning" />
        Before saving changes...
    </MudText>

    <!-- Scrollable error list -->
    <MudContainer Class="ps-8 mb-7"
                  Style="max-height:300px; overflow-y:auto;">
        <ul>
            @foreach (var failure in Failures)
            {
                var msg = failure.ErrorMessage;

                <li>
                    <MudText Typo="Typo.body2" Class="mb-1">
                        @msg
                    </MudText>
                </li>
            }
        </ul>
    </MudContainer>

    <JustifiedFlexGroup Align="Align.End">
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   OnClick="Done">
            Got It
        </MudButton>
    </JustifiedFlexGroup>
</Dialog>
